  out.adequate_mo = lookupCoded_(rec['resource/adeq_mos'], YES_NO_MAP);
  out.employed_nurses = toIntegerOrBlank_(rec['resource/employed_rn']);
  out.contract_nurses = toIntegerOrBlank_(rec['resource/contract_rn']);

function pullAllForms() {
  const token = getApiToken();
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  FORM_CONFIG.forEach(function (form) {
    try {
      Logger.log('Pulling form: ' + form.uid + ' → "' + form.sheetName + '"');
      let records = fetchAllSubmissions(form.uid, token);
      if (form.sheetName === 'Newborn Unit') records = records.map(transformNewbornUnitRecord_);
      const result = appendNewRecordsToSheet(ss, form.sheetName, records);
      Logger.log('Sheet "' + form.sheetName + '": appended ' + result.appended +
        ' new row(s); skipped ' + result.skipped + ' existing uuid(s).');
    } catch (err) {
      Logger.log('ERROR pulling ' + form.uid + ': ' + err.message);
    }
  });
}

function fullRefreshAllForms() {
  const token = getApiToken();
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  FORM_CONFIG.forEach(function (form) {
    try {
      Logger.log('Full refresh for form: ' + form.uid + ' → "' + form.sheetName + '"');
      const sheet = ss.getSheetByName(form.sheetName);
      if (sheet) sheet.clearContents();
      let records = fetchAllSubmissions(form.uid, token);
      if (form.sheetName === 'Newborn Unit') records = records.map(transformNewbornUnitRecord_);
      const result = appendNewRecordsToSheet(ss, form.sheetName, records);
      Logger.log('Sheet "' + form.sheetName + '": wrote ' + result.appended + ' row(s).');
    } catch (err) {
      Logger.log('ERROR refreshing ' + form.uid + ': ' + err.message);
    }
  });
}

function getApiToken() {
  const token = PropertiesService.getScriptProperties().getProperty('KOBO_API_TOKEN');
  if (!token) {
    throw new Error(
      'Missing Script Property KOBO_API_TOKEN. ' +
      'Set it under Project Settings → Script properties.'
    );
  }
  return token;
}

function fetchAllSubmissions(assetUid, token) {
  let allResults = [];
  let start = 0;
  let total = null;
  do {
    const url = KOBO_BASE_URL + '/api/v2/assets/' + assetUid + '/data.json'
      + '?limit=' + PAGE_SIZE + '&start=' + start;
    const response = UrlFetchApp.fetch(url, {
      method: 'get',
      headers: { Authorization: 'Token ' + token },
      muteHttpExceptions: true,
    });
    const code = response.getResponseCode();
    if (code !== 200) {
      throw new Error('Kobo API returned HTTP ' + code + ' for ' + assetUid + ': ' + response.getContentText());
    }
    const json = JSON.parse(response.getContentText());
    total = json.count;
    allResults = allResults.concat(json.results);
    start += PAGE_SIZE;
    Utilities.sleep(200);
  } while (start < total);
  return allResults;
}

function transformNewbornUnitRecord_(rec) {

    'service/glucose': true, 'service/bilirubin': true, 'service/cranial_ultras': true,
    'service/x_ray': true, 'service/avg_time': true,
    'resource/employed_neonatologists': true, 'resource/contract_neonatologists': true,
    'resource/employed_paed': true, 'resource/contract_paed': true, 'resource/available_24hrs': true,
    'resource/employed_mos': true, 'resource/contract_mos': true, 'resource/adeq_mos': true,
    'resource/employed_rn': true, 'resource/contract_rn': true, 'resource/adeq_rn': true,
    'resource/employed_cos': true, 'resource/contract_cos': true, 'resource/adeq_cos': true,
    'records/death_reg': true, 'records/consistent_use': true, 'records/integrated_rh_mch': true,
    'records/inpatient_neonatal_reg': true, 'records/nb_admission': true,
    'records/perinatal_notification': true, 'records/perinatal_review': true,
    'privacy/visual_privacy': true, 'privacy/auditory_privacy': true,
